# MM KConfig fragment — applied on top of base defconfig
# Used by deploy, implementer, and tester (LTP phase)
# Does NOT include KUNIT — KUnit is enabled separately by the tester
# for the KUnit test phase to avoid running hundreds of KUnit suites
# at boot during non-KUnit test runs.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_HUGETLBFS=y
CONFIG_MEMCG=y
CONFIG_ZSWAP=y
CONFIG_ZRAM=y
CONFIG_DEBUG_VM=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_UBSAN=y
CONFIG_SLUB_DEBUG=y
# CONFIG_ARM64_MTE is not set
