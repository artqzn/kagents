# Copy to ~/.kag.env and override any defaults.

# ─── Switch active subsystem ────────────────────────────────────────
# KAG_SUBSYSTEM=sched    # or block, fs, ...

# ─── Switch provider per agent ──────────────────────────────────────
# Example: DeepSeek for cost, Anthropic for Reviewer quality
# KAG_LLM_PROVIDER_REVIEWER=anthropic
# KAG_LLM_MODEL_REVIEWER=anthropic/claude-sonnet-4-5

# ─── API keys (one per provider you use) ────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# ZAI_API_KEY=...

# ─── Optional: external workspace ───────────────────────────────────
# KAG_WORKSPACE="/Volumes/External/kernel-workspace"
