# ─── Identity ───────────────────────────────────────────────────────
KAG_FRAMEWORK_VERSION="0.1.0"

# ─── Paths ──────────────────────────────────────────────────────────
KAG_WORKSPACE="${HOME}/kernel-workspace"
KAG_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ─── Docker ─────────────────────────────────────────────────────────
KAG_DOCKER_COMPOSE="${KAG_REPO_ROOT}/docker/compose.yml"
KAG_VOLUME_CCACHE="kag-ccache"
KAG_VOLUME_BUILD="kag-build"
KAG_IMAGE_LABEL="org.kag.project=kernel-agents"

# ─── Active subsystem (default mm; switch via ~/.kag.env) ───────────
KAG_SUBSYSTEM="${KAG_SUBSYSTEM:-mm}"

# ─── Resources (informational — set actual limits in Docker settings) ──
KAG_DOCKER_MEMORY_GB=12
KAG_DOCKER_CPUS=6
KAG_CONTAINER_MEM_PLANNER=2g
KAG_CONTAINER_MEM_IMPL=4g
KAG_CONTAINER_MEM_REVIEWER=2g
KAG_CONTAINER_MEM_TESTER=6g
KAG_CONTAINER_MEM_ARCHIVIST=512m

# ─── Kernel ─────────────────────────────────────────────────────────
KAG_KERNEL_REPO="https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git"
KAG_KERNEL_BRANCH="master"
KAG_ARCH="arm64"
KAG_LLVM=1

# ─── LLM (per-agent, provider-agnostic via LiteLLM) ─────────────────
# DeepSeek defaults. Swap per-agent via ~/.kag.env.

KAG_LLM_PROVIDER_PLANNER=deepseek
KAG_LLM_MODEL_PLANNER=deepseek/deepseek-chat
KAG_LLM_MAX_TOKENS_PLANNER=8000

KAG_LLM_PROVIDER_IMPLEMENTER=deepseek
KAG_LLM_MODEL_IMPLEMENTER=deepseek/deepseek-chat
KAG_LLM_MAX_TOKENS_IMPLEMENTER=8000

KAG_LLM_PROVIDER_REVIEWER=deepseek
KAG_LLM_MODEL_REVIEWER=deepseek/deepseek-reasoner
KAG_LLM_MAX_TOKENS_REVIEWER=8000

KAG_LLM_PROVIDER_TESTER=deepseek
KAG_LLM_MODEL_TESTER=deepseek/deepseek-chat
KAG_LLM_MAX_TOKENS_TESTER=4000

# Optional fallback chains (comma-separated, tried in order on failure)
# KAG_LLM_FALLBACK_PLANNER="anthropic/claude-sonnet-4-5"

# ─── Timeouts ───────────────────────────────────────────────────────
KAG_AGENT_TIMEOUT_SEC=3600
KAG_QEMU_TIMEOUT_SEC=600
KAG_BUILD_TIMEOUT_SEC=1800

# ─── State DB schema version ────────────────────────────────────────
KAG_STATE_SCHEMA_VERSION=2
